APP_PORTA=3001
APP_PREFIXO=api

BANCO_HOST=localhost
BANCO_PORTA=5432
BANCO_USUARIO=pelada
BANCO_SENHA=pelada
BANCO_NOME=gerenciador_pelada

# A aplicacao recusa subir com segredo curto ou de exemplo — um segredo
# conhecido deixa qualquer pessoa forjar um token de organizador. Gere o seu:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SEGREDO=
JWT_EXPIRACAO=30d

# Origens que podem chamar a API pelo navegador, separadas por virgula.
# Vazio = nenhuma origem externa. Nao use curinga.
CORS_ORIGENS=http://localhost:3000

# Codigo exigido para criar conta. Vazio = cadastro fechado.
# O cadastro cria um ORGANIZADOR, entao nao deixe aberto num endereco publico.
#   node -e "console.log(require('crypto').randomBytes(6).toString('base64url'))"
CADASTRO_CONVITE=
